# Local development settings. Do not store production secrets here.
CASECLOSED_ENV=development
CASECLOSED_DATABASE_URL=sqlite:///./data/caseclosed.sqlite3
CASECLOSED_BOOTSTRAP_PASSWORD=change-me-for-local-development
CASECLOSED_SESSION_LIFETIME_MINUTES=1440
CASECLOSED_BACKGROUND_WORKER_ENABLED=true
CASECLOSED_BACKGROUND_WORKER_COUNT=2
CASECLOSED_BACKGROUND_WORKER_IDLE_SLEEP_SECONDS=1
CASECLOSED_BACKGROUND_WORKER_STALE_TIMEOUT_SECONDS=90
CASECLOSED_BACKGROUND_WORKER_STALE_CHECK_SECONDS=30

# Google/Gmail OAuth entrypoint. This only enables manual connection; mail loading is wired later.
# Configure the same redirect URI in Google Cloud Console.
# CASECLOSED_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# CASECLOSED_GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
CASECLOSED_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google/gmail/oauth/callback
CASECLOSED_GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Optional. Provider secrets stay in .env. Model profiles only name env keys.
# CASECLOSED_OPENAI_API_KEY=sk-...

# Select the model profile per LLM function_type. If unset, that function uses mock.
# Profile files live in backend/llm_model_profiles by default.
CASECLOSED_LLM_PROFILE_MAIL_IMPORTANCE_CLASSIFICATION=openai_gpt_5_2
CASECLOSED_LLM_PROFILE_CONTACT_REGISTRATION_PREFILL=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_MAIL_SUMMARY=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_MAIL_THREAD_SUMMARY=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_MAIL_CASE_SELECTION=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_REPLY_DRAFT_GENERATION=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_NEW_MAIL_DRAFT_GENERATION=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_MAIL_TASK_SUGGESTION=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_CALENDAR_CANDIDATE_EXTRACTION=openai_gpt_5_4
CASECLOSED_LLM_PROFILE_PREPARATION_TASK_SUGGESTION=openai_gpt_5_4
# CASECLOSED_LLM_MODEL_PROFILES_DIR=backend/llm_model_profiles
